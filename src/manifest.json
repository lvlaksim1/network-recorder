{
  "manifest_version": 3,
  "name": "Network Recorder",
  "version": "1.7.0",
  "description": "Records network metadata with selective API/text bodies by default, optional binary/deep diagnostics/Chromium Tracing, and exports a size-efficient compressed ZIP.",
  "permissions": [
    "storage",
    "debugger",
    "downloads",
    "offscreen",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Запись активности текущей вкладки"
  }
}
